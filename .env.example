# API Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Supabase Configuration
# Obtén las credenciales en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Resend API Key (para envío de emails)
# Obtén tu API Key en: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps API Key
# Obtén tu API Key en: https://console.cloud.google.com/apis/credentials
# Habilita las siguientes APIs:
# - Maps JavaScript API
# - Places API
# - Geocoding API
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=tu_api_key_aqui
